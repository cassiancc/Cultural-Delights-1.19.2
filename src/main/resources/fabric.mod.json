    "main": [
      "com.baisylia.culturaldelights.CulturalDelights"
    ],
    "client": [
      "com.baisylia.culturaldelights.refabricated.CulturalDelightsRefabricatedClient"
    ]
  },
  "mixins": [
    "culturaldelights.mixins.json"
  ],
  "accessWidener": "culturaldelights.classtweaker",
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "farmersdelight": ">=1.21.1-3.3.6"
