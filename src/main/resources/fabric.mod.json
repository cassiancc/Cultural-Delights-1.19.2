  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}",
    "cassiancc"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "${license}",
  "icon": "culturaldelights.png",
  "environment": "*",
